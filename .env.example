# ─────────────────────────────────────────────────────────────────────────────
# La DEMO no necesita ninguna variable: si no defines estas, la app arranca contra
# un backend simulado en el navegador (ver src/integrations/demo/).
#
# Define las siguientes SOLO si quieres conectar la app a un proyecto Supabase real
# (en cuanto existan, deja de usarse el mock). El esquema/migraciones de producción
# no se incluyen en este repositorio de portfolio.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
