# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env (never committed). The app always runs against a Supabase
# project: the demo one (also the pre-production environment) in development.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project (CLI, migrations, scripts)
SUPABASE_PROJECT_REF=<project-ref>
# Account access token (CLI / Management API)
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-side only (bypasses RLS). Never with a VITE_ prefix.
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Frontend (required). Vite expands ${...}, so they can reuse the values above.
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_PUBLISHABLE_KEY=${SUPABASE_PUBLISHABLE_KEY}

# Redsys test environment key (published by Redsys for its test environment)
REDSYS_TEST_SECRET_KEY=

# Password for the demo users created by scripts/seed-auth.mjs
DEMO_USERS_PASSWORD=

# Demo / pre-production only: pick a fictitious account from a list instead of
# signing in (the Supabase project also needs the DEMO_ACCESS=true secret for
# demo-login). Never set it in production.
VITE_DEMO_ACCESS=true

# Booking agent: any OpenAI-compatible model. Development uses the local
# Ollama through scripts/llm-gateway.mjs; these go to the Supabase function
# secrets (LLM_BASE_URL too).
LLM_API_KEY=
LLM_MODEL=

# Where hotels' booking webs answer. Each hotel gets <slug>.<VITE_PLATFORM_DOMAIN>
# (a wildcard DNS record to the frontend host) and can point its own subdomain
# (e.g. reservas.suhotel.com) with a CNAME to VITE_PLATFORM_CNAME. Without them
# the app runs as the demo, with a switcher between hotels.
VITE_PLATFORM_DOMAIN=
VITE_PLATFORM_CNAME=
