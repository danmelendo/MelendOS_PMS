# ─────────────────────────────────────────────────────────────────────────────
# The DEMO needs no variables: without VITE_SUPABASE_* the app runs against an
# in-browser mock backend (see src/integrations/demo/).
#
# Copy to .env (never committed) to work against a real Supabase project.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project (CLI, migrations, scripts)
SUPABASE_PROJECT_REF=<project-ref>
# Account access token (CLI / Management API)
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-side only (bypasses RLS). Never with a VITE_ prefix.
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Frontend: set these to switch the app from the mock to the real project.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Redsys test environment key (published by Redsys for its test environment)
REDSYS_TEST_SECRET_KEY=

# Password for the demo users created by scripts/seed-auth.mjs
DEMO_USERS_PASSWORD=

# Demo builds only: pick a fictitious account from a list instead of signing in
# (the Supabase project also needs the DEMO_ACCESS=true secret for demo-login).
# Never set it in production.
# VITE_DEMO_ACCESS=true

# Booking agent: any OpenAI-compatible model. Development uses the local
# Ollama through scripts/llm-gateway.mjs; these go to the Supabase function
# secrets (LLM_BASE_URL too).
LLM_API_KEY=
LLM_MODEL=
