{
	# Certificates from Let's Encrypt; state in the caddy_data volume.
	servers {
		protocols h1 h2 h3
	}
}

# Web of one installation: import web <instance>
(web) {
	root * /srv/instances/{args[0]}/web
	# The installation's own settings (deploy/vps/tools/web-config.sh).
	handle /config.js {
		root * /srv/instances/{args[0]}
		header Cache-Control no-store
		file_server
	}
	# Revalidate everything but the hashed assets: a new version shows at once.
	@html not path /assets/*
	header @html Cache-Control no-cache
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}

import sites/*.caddy
