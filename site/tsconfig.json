{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "types": ["vite/client", "node"],
    // Shared Edge Function code imports supabase-js the Deno way.
    "paths": { "npm:@supabase/supabase-js@2": ["./node_modules/@supabase/supabase-js"] }
  },
  "include": ["src", "supabase/functions/_shared", "vite.config.ts"]
}
