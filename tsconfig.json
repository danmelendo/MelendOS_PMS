{
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "supabase/functions/_shared/domain/**/*.ts",
    "supabase/functions/_shared/payments/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.db.config.ts",
    "supabase/tests/**/*.ts",
    "scripts/**/*.mjs",
    "eslint.config.js"
  ],
  // Deno-only files (npm: imports, Deno globals) are checked at deploy time.
  "exclude": ["supabase/functions/_shared/payments/accounts.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"],
      "@domain/*": ["./supabase/functions/_shared/domain/*"]
    }
  }
}
