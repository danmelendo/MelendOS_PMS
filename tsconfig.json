{
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "supabase/functions/_shared/domain/**/*.ts",
    "supabase/functions/_shared/payments/**/*.ts",
    "supabase/functions/_shared/tools/**/*.ts",
    "supabase/functions/_shared/sim/**/*.ts",
    "supabase/functions/_shared/agent/**/*.ts",
    "supabase/functions/_shared/mcp/**/*.ts",
    "supabase/functions/_shared/copilot/**/*.ts",
    "supabase/functions/_shared/demo/**/*.ts",
    "supabase/functions/_shared/channels/**/*.ts",
    "supabase/functions/_shared/ses/**/*.ts",
    "supabase/functions/_shared/verifactu/**/*.ts",
    "supabase/functions/_shared/email/**/*.ts",
    "supabase/functions/_shared/onboarding/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.db.config.ts",
    "supabase/tests/**/*.ts",
    "supabase/evals/**/*.ts",
    "vitest.eval.config.ts",
    "scripts/**/*.mjs",
    "scripts/**/*.ts",
    "eslint.config.js"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"],
      "@domain/*": ["./supabase/functions/_shared/domain/*"],
      "@shared/*": ["./supabase/functions/_shared/*"],
      // Shared Edge Function code imports supabase-js the Deno way.
      "npm:@supabase/supabase-js@2": ["./node_modules/@supabase/supabase-js"]
    }
  }
}
